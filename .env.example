# Sao chép: cp .env.example .env
#
# Thứ tự khuyến nghị (lần đầu):
#   cp routes.json.example routes.json
#   make init-sites     # hoặc make gen-sites (infra + project conf)
#   make gen-ssl        # cert TLS local
#   make hosts
#   make up-all        # gateway + DB + dev services nhẹ (không LocalStack)
#   make up-localstack # chỉ bật thêm khi project cần S3/SQS/SNS/Logs
#
# Gateway: routes.json — xem ROUTES.md
#   make gen-sites      hoặc   bash gen-gateway-sites.sh
# Cert + sites: make gen-ssl   hoặc   bash gen-dev-ssl.sh .env certs
#
# Windows bundle: C:\Users\Public\dev_ssl\<PROJECT_NAME>\
#   dev-rootCA.crt, <PROJECT>.<SSL_DOMAIN_BASE>.crt/.key/.pfx, install-windows-trust.*
#
# Tiền tố container/volume Docker (vd. dev_mysql, dev_gateway_nginx)
PROJECT_NAME=dev

# TLS — mọi host routes.json: *.<SSL_DOMAIN_BASE> (vd. saas-api.local.com)
# File cert nginx (SAN = base + wildcard): certs/${PROJECT_NAME}.${SSL_DOMAIN_BASE}.crt + .key
#   vd. PROJECT_NAME=dev, SSL_DOMAIN_BASE=local.com → dev.local.com.crt, dev.local.com.key
SSL_DOMAIN_BASE=local.com

# --- print-hosts-from-env.sh ---
HOSTS_IP=127.0.0.1

# --- MySQL (docker-compose + initdb; khớp api/src/.env) ---
MYSQL_ROOT_PASSWORD=123456
MYSQL_DB_LOCAL=db_local
MYSQL_DB_TEST=laravel_test
MYSQL_APP_USER=local_dev
MYSQL_APP_PASSWORD=123456

BASE_SHARED_NETWORK_NAME=base_shared_net
# Mạng Docker chung (external) — make up tự `docker network create` nếu chưa có.
# Project api/portal join cùng tên qua `external: true`.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MYSQL_PORT=13306
# MySQL 8.0 (mysql_native_password), expose host port
MYSQL_80_PORT=13307
# Data bind mount (Laradock-style) — prefix folder; subpath tự nối trong compose.
# Rỗng/không set → ./data/mysql, ./data/mysql80, ./data/postgres, ./data/redis
# DATA_PATH_HOST=~/env_data

# --- PostgreSQL (docker-compose; alias mạng saas-postgres) ---
POSTGRES_USER=local_dev
POSTGRES_PASSWORD=123456
POSTGRES_DB=one_crm
POSTGRES_PORT=15432

# pgAdmin — https://pgadmin.local.com
PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=123456

# Redis Commander — https://redisadmin.local.com (label:host:port)
REDIS_PORT=6379
REDIS_COMMANDER_HOSTS=local:redis:6379

# phpMyAdmin import lớn (gateway timeout + PHP + MySQL)
PMA_UPLOAD_LIMIT=1G
PMA_MEMORY_LIMIT=1G
PMA_MAX_EXECUTION_TIME=3600

# --- gen-gateway-sites.sh (make gen-sites) — khớp tên container với PROJECT_NAME=dev → dev_* ---
# API/portal fallback khi routes.json không khai báo port
# api.internal (tùy chọn): Host header gateway → API nginx; mặc định = api.host. Chỉ set khi khác host (vd. laravel.api.com).
API_CONTAINER_PORT=80
PORTAL_CONTAINER_PORT=3000
GATEWAY_CONTAINER=dev_gateway_nginx

# Mount source cho gateway fastcgi (docroot trong routes.json phải khớp path trong container)
MAIRY_PROJECT_WORKSPACE=/home/vutv/workspace
WEBBEDS_PROJECT_WORKSPACE=/home/vutv/workspace

# --- docker-compose.services.yml (LocalStack + StackPort chạy riêng bằng make up-localstack) ---
AWS_REGION=us-east-1
