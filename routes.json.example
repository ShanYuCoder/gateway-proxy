{
  "_comment": "cp routes.json.example routes.json — thêm/sửa project thật; host *.<SSL_DOMAIN_BASE>. routes.json không commit.",
  "shared": [
    {
      "title": "Shared (DB admin UI — docker-compose.yml)",
      "hosts": [
        "phpmyadmin.local.com",
        "pgadmin.local.com",
        "redisadmin.local.com"
      ]
    },
    {
      "title": "Shared (dev tools — make up-localstack / docker-compose.services.yml)",
      "hosts": [
        "mail.local.com",
        "mock.local.com",
        "stackport.local.com"
      ]
    }
  ],
  "projects": {
    "internal": {
      "api": {
        "host": "api-internal.local.com",
        "stack": "internal",
        "internal": "laravel.api.com"
      },
      "portals": [
        {
          "host": "portal-internal.local.com",
          "stack": "internal"
        }
      ]
    },
    "globalExternal": {
      "external": true,
      "sites": [
        {
          "host": "api-external.local.com",
          "role": "web",
          "container": "dev_external_php",
          "docroot": "/var/www/html/public"
        },
        {
          "host": "external.local.com",
          "role": "node",
          "container": "dev_external_frontend_node",
          "port": 3000
        }
      ]
    }
  }
}
